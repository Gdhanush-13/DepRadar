# Database connection; SQLite is convenient for local development
DATABASE_URL=sqlite+aiosqlite:///./depradar.db
# Secret used to sign session tokens
JWT_SECRET=replace-with-a-long-random-secret
# Set to production on Render to reject placeholder secrets.
DEPRADAR_ENV=development
# Optional GitHub API token for higher rate limits
GITHUB_TOKEN=
# Optional GitHub OAuth credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL used in OAuth callbacks and README badges
APP_BASE_URL=http://localhost:8000
# Secret header required by the nightly rescan workflow
INTERNAL_RESCAN_KEY=replace-with-a-second-long-random-secret
